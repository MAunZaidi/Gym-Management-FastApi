# Vercel/serverless: Supabase Dashboard > Connect > Transaction pooler (port 6543).
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SECRET_KEY=your-secret-key
FRONTEND_ORIGINS=http://localhost:3000,https://adapt-gym-management.vercel.app
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
SQL_ECHO=false
